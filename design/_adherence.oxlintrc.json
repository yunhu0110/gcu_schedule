      "--ink-08",
      "--ink-12",
      "--ink-24",
      "--ink-60",
      "--lh-body",
      "--lh-bodysm",
      "--lh-caption",
      "--lh-display",
      "--lh-h1",
      "--lh-h2",
      "--lh-mono",
