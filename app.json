{
  "expo": {
    "name": "월간gcu",
    "slug": "gcuschedule",
    "owner": "yunhu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gcuschedule",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.yunhu.gcuschedule",
      "supportsTablet": false
    },
    "android": {
      "package": "com.yunhu.gcuschedule",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 등록하기 위해 사진 접근이 필요해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/gcu_schedule"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2af27595-c3f9-46f4-8ea3-fb0ae51841d2"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2af27595-c3f9-46f4-8ea3-fb0ae51841d2"
    }
  }
}
