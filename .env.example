# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 git에 커밋되지 않음)
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 포함되므로 "공개돼도 되는" 값만 넣는다.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 새 Supabase publishable(공개) 키. service_role / sb_secret_ 키는 절대 여기 넣지 않는다.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
